{
  "name": "local-video-host",
  "version": "1.0.0",
  "private": true,
  "description": "Secure self-hosted video storage API with an admin dashboard",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/ensure-deps.mjs && vite build && tsc -p tsconfig.server.json",
    "start": "node scripts/start.mjs",
    "test": "node scripts/ensure-deps.mjs && vitest run",
    "lint": "node scripts/ensure-deps.mjs && eslint . && tsc -p tsconfig.server.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "package:zip": "node scripts/package-zip.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "busboy": "^1.6.0",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/archiver": "^8.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/busboy": "^1.5.5",
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.2",
    "archiver": "^8.0.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "lucide-react": "^1.61.0",
    "postcss": "^8.5.31",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "supertest": "^7.3.1",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
